# ORDA Python 파이프라인 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣을 것 (.env 는 git 추적 제외)

# PostgreSQL 접속 정보
ORDA_DB_HOST=localhost
ORDA_DB_PORT=5432
ORDA_DB_NAME=orda
ORDA_DB_USER=postgres
ORDA_DB_PASSWORD=change-me

# local: disable / supabase: require
ORDA_DB_SSLMODE=disable

# PostGIS 스키마 (실제 설치된 스키마명)
ORDA_POSTGIS_SCHEMA=public

# 적재 시 기존 데이터 삭제 허용 여부 (true/false)
ORDA_ALLOW_DESTRUCTIVE_LOAD=true
